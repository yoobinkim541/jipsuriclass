NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_BLOG_ID=it77khy
GEMINI_API_KEY=
GEMINI_BLOG_SUMMARY_MODEL=gemini-2.5-flash-lite

# Optional: used for the interactive office map. If empty, the static Naver map embed stays available.
VITE_NAVER_MAP_CLIENT_ID=
VITE_NAVER_MAP_LAT=
VITE_NAVER_MAP_LNG=

# Required for inquiry storage and customer/admin flows.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: used only when email alerts are enabled.
RESEND_API_KEY=
ADMIN_EMAIL=

# Optional: real-time Telegram alert on new inquiries.
# 1) @BotFather에서 봇 생성 → 토큰 발급  2) 봇과 대화 시작 후
#    https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: read-only Naver Search Ads daily report (run from the Oracle VM).
# API credentials are issued in Search Ads Center > Tools > API Manager.
NAVER_SA_ACCESS_LICENSE=
NAVER_SA_SECRET_KEY=
NAVER_SA_CUSTOMER_ID=
NAVER_SA_API_BASE_URL=https://api.searchad.naver.com
# Optional. Comma-separated hints trigger one /keywordstool request per report run.
NAVER_SA_KEYWORD_HINTS=
# Recommended separate destination. Falls back to TELEGRAM_CHAT_ID when empty.
TELEGRAM_REPORT_CHAT_ID=

# Optional: server-only Supabase history storage for the VM report runner.
# Never expose this key through VITE_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=
