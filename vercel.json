{
  "buildCommand": "astro build",
  "framework": "astro",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/notify-inquiries",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/plumbing-hero-pipes.webp",
      "headers": [{ "key": "X-Robots-Tag", "value": "noimageindex" }]
    },
    {
      "source": "/assets/carpentry-hero-wood.webp",
      "headers": [{ "key": "X-Robots-Tag", "value": "noimageindex" }]
    },
    {
      "source": "/assets/film-hero-interior.webp",
      "headers": [{ "key": "X-Robots-Tag", "value": "noimageindex" }]
    },
    {
      "source": "/assets/paint-hero-interior.webp",
      "headers": [{ "key": "X-Robots-Tag", "value": "noimageindex" }]
    },
    {
      "source": "/assets/wallpaper-floor-hero-interior.webp",
      "headers": [{ "key": "X-Robots-Tag", "value": "noimageindex" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/account",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/account/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/mypage",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/mypage/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/diagnosis",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/diagnosis/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/estimate",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/portfolio",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/service",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/service/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/area",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/area/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/service/electric/price",
      "destination": "/service/electric/pricing",
      "permanent": false
    },
    {
      "source": "/service/tile/price",
      "destination": "/service/tile/pricing",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/service/:path*",
      "destination": "/service/:path*/index.html"
    },
    {
      "source": "/area/:path*",
      "destination": "/area/:path*/index.html"
    }
  ]
}
